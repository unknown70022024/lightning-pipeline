# 复制到 ~/.lightning.env 或本目录的 .env（两者都被 .gitignore 排除）
# 推荐放 ~/.lightning.env —— 在仓库外，绝无被误提交的可能

# EUMETSAT Data Store API 密钥
#   注册: https://user.eumetsat.int/
#   生成: https://api.eumetsat.int/api-key/
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# 以下都是可选覆盖项
# LIGHT_SOURCES=blitzortung,glm,eumetsat
# LIGHT_MAX_POINTS=2500
# LIGHT_POINTS_PER_CELL=3
# LIGHT_WINDOW_MINUTES=60
# GLM_FILE_STRIDE=1
# LIGHT_BLITZ_LON_MIN=70
# LIGHT_BLITZ_LON_MAX=180
# LIGHT_BLITZ_LAT_MIN=-55
# LIGHT_BLITZ_LAT_MAX=60
